# ─────────────────────────────────────────────────────────────────────
# Multicode Agent — environment template
# Copy to `.env` (backend) or `frontend/.env.local` (frontend) and edit.
# Every value below is optional; the defaults are what the app ships with.
# ─────────────────────────────────────────────────────────────────────

# ── Backend (FastAPI, app/core/config.py) ──
MULTICODE_HOST=127.0.0.1
MULTICODE_PORT=8001

# Comma separated list of browser origins allowed to call the API.
MULTICODE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Sandbox limits for the "Run Code" feature.
MULTICODE_SANDBOX_TIMEOUT=5
MULTICODE_SANDBOX_MAX_OUTPUT=20000
MULTICODE_SANDBOX_MAX_CODE=40000

# ── Frontend (Vite) ──
# Absolute API base URL. Leave empty to use the dev proxy on /api.
VITE_API_BASE_URL=

# Only used by `npm run dev` to know where to proxy /api requests.
MULTICODE_BACKEND_URL=http://127.0.0.1:8001
